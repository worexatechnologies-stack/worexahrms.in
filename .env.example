# ==============================================================================
# HRMS Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your root directory and set the values appropriately.
# NEVER commit the actual .env file with production secrets into version control.

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Configuration
# ------------------------------------------------------------------------------
# Standard MongoDB connection URI. Replace credentials and cluster host.
# Example: mongodb+srv://db_user:StrongPasswordHere@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/<auth_source>?retryWrites=true&w=majority

# Primary / Master database name (defaults to 'hrms')
MONGODB_DB_NAME=hrms

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Security
# ------------------------------------------------------------------------------
# Secret key used for signing HS256 JWT access tokens.
# MUST be a cryptographically random string (at least 64 characters long).
# Generate using: php -r 'echo bin2hex(random_bytes(32));'
HRMS_JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret

# Cookie SameSite attribute ('Lax' for same-domain, 'None' for cross-domain HTTPS)
HRMS_COOKIE_SAMESITE=Lax

# ------------------------------------------------------------------------------
# 3. Environment & Application Mode
# ------------------------------------------------------------------------------
# Options: 'production', 'staging', 'local'
APP_ENV=production
HRMS_ENV=production

# ------------------------------------------------------------------------------
# 4. Strict CORS Whitelist
# ------------------------------------------------------------------------------
# Comma-separated list of approved frontend origins.
# Substrings and wildcards are strictly rejected.
# Include both standard domain and www subdomain if applicable.
HRMS_ALLOWED_ORIGINS=https://worexahrms.in,https://www.worexahrms.in,https://worexahrms.xyz,https://www.worexahrms.xyz
HRMS_FRONTEND_ORIGIN=https://worexahrms.in

# ------------------------------------------------------------------------------
# 5. Geofencing & Office Location Configuration (Optional)
# ------------------------------------------------------------------------------
# Comma-separated office location coordinates: name|latitude|longitude|radius_meters
HRMS_LOGIN_ALLOWED_LOCATIONS=Headquarters|12.9716|77.5946|200

# ------------------------------------------------------------------------------
# 6. Vite Frontend Build Configuration (Optional client settings)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_API_MAX_CONCURRENT=6
VITE_API_BUSY_RETRIES=2
