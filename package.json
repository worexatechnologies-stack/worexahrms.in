{
  "name": "hrms-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx concurrently -n local-api,vite -c blue,green \"npm run dev:local-api\" \"npm run dev:vite\"",
    "dev:local-api": "node scripts/local-dev-api.js",
    "dev:vite": "vite --host",
    "dev:php": "php -S 127.0.0.1:8096 -t api",
    "build": "vite build && node scripts/copy-build-assets.js",
    "preview": "npx concurrently -n php,preview -c blue,green \"npm run dev:php\" \"vite preview\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.1.2",
    "@mui/x-charts": "^9.7.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@vitejs/plugin-react": "^5.1.2",
    "axios": "^1.15.1",
    "lucide-react": "^1.33.0",
    "mongodb": "^7.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.10.1",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.3.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.68.5"
  }
}
