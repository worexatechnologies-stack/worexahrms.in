# ─── MongoDB ────────────────────────────────────────────────────────────────
# Comment out one block and uncomment the other to switch between Atlas and local.

# Production — MongoDB Atlas
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster.mongodb.net
# MONGODB_DB_NAME=hrms

# Local development
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=hrms
 
# ─── App ────────────────────────────────────────────────────────────────────
HRMS_JWT_SECRET=change-this-secret-before-production
HRMS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HRMS_LOGIN_ALLOWED_LOCATIONS=
VITE_API_MAX_CONCURRENT=1
VITE_API_BUSY_RETRIES=2
VITE_API_BASE_URL=/api

# ─── Biometric Device (eSSL) ────────────────────────────────────────────────
# BIOMETRIC_IP=192.168.1.201
# BIOMETRIC_PORT=80
# BIOMETRIC_USER=essl
# BIOMETRIC_PASSWORD=essl
# BIOMETRIC_TIMEOUT=10
